PORT=5000
MONGODB_URI=your_mongodb_atlas_connection_string
JWT_SECRET=your_jwt_secret
CLIENT_ORIGIN=http://localhost:5173
RECORDING_RETENTION_DAYS=30
# Production stays disabled until security and institutional policy approval.
RECORDING_PRODUCTION_APPROVED=false
OPENAI_API_KEY=your_ai_provider_key
AI_QUESTION_API_URL=https://api.openai.com/v1/chat/completions
AI_QUESTION_MODEL=gpt-4o-mini
PASS_PERCENTAGE=40
# Password-reset OTP email uses Gmail SMTP only. The sender address must match
# PASSWORD_RESET_SMTP_USER. Generate an App Password; do not use the normal Gmail password.
PASSWORD_RESET_FROM="ExamNova AI Support <your_sending_gmail@gmail.com>"
PASSWORD_RESET_SMTP_HOST=smtp.gmail.com
PASSWORD_RESET_SMTP_PORT=587
PASSWORD_RESET_SMTP_SECURE=false
PASSWORD_RESET_SMTP_USER=your_sending_gmail@gmail.com
PASSWORD_RESET_SMTP_APP_PASSWORD=your_gmail_app_password
